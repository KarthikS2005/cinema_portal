generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Ticket {
  id        String   @id @default(cuid())
  movieId   String
  movieName String
  seatId    String
  seatClass String
  price     Float
  status    String   @default("booked") // "booked", "scanned", "cancelled"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  role      String   @default("user") // "user", "admin", "hr"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Employee {
  id        String   @id @default(cuid())
  name      String
  role      String
  location  String
  wage      Float
  type      String   // "hourly", "monthly"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tasks     Task[]
}

model Payment {
  id          String   @id @default(cuid())
  amount      Float
  method      String   // "Credit Card", "NPCI (UPI)", "Bank Transfer", "Cash"
  purpose     String   // "Salary", "Booking"
  referenceId String?
  createdAt   DateTime @default(now())
}

model Room {
  id               String   @id @default(cuid())
  name             String
  status           String   @default("Available") // "Available", "Cleaning", "Maintenance"
  cleaningSchedule String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Task {
  id          String    @id @default(cuid())
  description String
  status      String    @default("Pending") // "Pending", "Completed"
  employeeId  String?
  employee    Employee? @relation(fields: [employeeId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Movie {
  id        String   @id @default(cuid())
  title     String
  region    String
  genre     String
  format    String?
  rating    String?
  summary   String?
  img       String?
  createdAt DateTime @default(now())
}
